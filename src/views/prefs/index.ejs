<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<section class="section">
  <div class="container">
    <h1 class="title">Preferences</h1>
    <div class="columns is-variable is-5">
      <div class="column">
        <div class="box glass-panel">
          <h2 class="title is-5">Account</h2>
          <form action="/prefs/account" method="post">
            <div class="field">
              <label class="label">Display name</label>
              <input class="input" type="text" name="displayName" value="<%= currentUser.displayName %>" />
            </div>
            <div class="field">
              <label class="label">Theme</label>
              <div class="select is-fullwidth">
                <select name="theme">
                  <option value="light" <%= currentUser.preferences?.theme === "light" || !currentUser.preferences?.theme ? "selected" : "" %>>Light</option>
                  <option value="dark" <%= currentUser.preferences?.theme === "dark" ? "selected" : "" %>>Dark</option>
                </select>
              </div>
            </div>
            <div class="field is-grouped is-grouped-multiline">
              <label class="checkbox mr-4"><input type="checkbox" name="digestEnabled" <%= currentUser.preferences?.digestEnabled ? "checked" : "" %> /> Email digest</label>
              <label class="checkbox"><input type="checkbox" name="unreadOnly" <%= currentUser.preferences?.unreadOnly ? "checked" : "" %> /> Unread first</label>
            </div>
            <div class="field">
              <label class="label">Sort order</label>
              <div class="select is-fullwidth">
                <select name="sortOrder">
                  <option value="newest">Newest first</option>
                  <option value="oldest">Oldest first</option>
                  <option value="title">Title</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label class="label">Article view</label>
              <div class="select is-fullwidth">
                <select name="articleView">
                  <option value="adaptive">Adaptive</option>
                  <option value="expanded">Expanded</option>
                </select>
              </div>
            </div>
            <button class="button is-primary">Save Preferences</button>
          </form>
        </div>

        <div class="box glass-panel">
          <h2 class="title is-5">OPML</h2>
          <form action="/prefs/opml/import" method="post">
            <div class="field">
              <label class="label">Paste OPML</label>
              <textarea class="textarea" name="opml" rows="8"></textarea>
            </div>
            <button class="button is-link">Import OPML</button>
            <a class="button is-light" href="/prefs/opml/export">Export OPML</a>
          </form>
        </div>
      </div>

      <div class="column">
        <div class="box glass-panel">
          <h2 class="title is-5">Labels</h2>
          <form action="/prefs/labels" method="post" class="mb-4">
            <div class="field">
              <input class="input" type="text" name="name" placeholder="Label name" required />
            </div>
            <div class="field">
              <input class="input" type="color" name="color" value="#3273dc" />
            </div>
            <button class="button is-info">Create Label</button>
          </form>
          <% labels.forEach((label) => { %>
            <span class="tag mr-2 mb-2" style="background:<%= label.color %>;color:#fff;"><%= label.name %></span>
          <% }) %>
        </div>

        <div class="box glass-panel">
          <h2 class="title is-5">Filters</h2>
          <% if (previewResults) { %>
            <div class="notification is-light mb-5">
              <p class="has-text-weight-semibold">Preview Results</p>
              <p class="mb-3">Scanned <%= previewResults.scannedCount %> articles and matched <%= previewResults.matchedCount %>.</p>
              <% if (previewResults.matches.length === 0) { %>
                <p>No articles matched this filter.</p>
              <% } %>
              <% previewResults.matches.forEach((result) => { %>
                <article class="box mb-3">
                  <p class="has-text-weight-semibold"><%= result.article.title %></p>
                  <p class="is-size-7 mb-2"><%= result.article.feedId?.title || "Feed" %></p>
                  <div class="tags">
                    <% result.changes.forEach((change) => { %>
                      <span class="tag <%= result.deleted ? 'is-danger is-light' : 'is-info is-light' %>"><%= change %></span>
                    <% }) %>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
          <form action="/prefs/filters" method="post" data-filter-form>
            <div class="field">
              <input class="input" type="text" name="caption" placeholder="Filter caption" value="<%= filterDraft?.sourceFilterId ? '' : (filterDraft?.caption || '') %>" required />
            </div>
            <div class="field">
              <label class="checkbox">
                <input type="hidden" name="enabled" value="off" />
                <input type="checkbox" name="enabled" value="on" <%= filterDraft?.sourceFilterId ? "checked" : (filterDraft ? (filterDraft.enabled ? "checked" : "") : "checked") %> />
                <span class="ml-2">Enabled</span>
              </label>
            </div>
            <div class="field">
              <div class="select is-fullwidth">
                <select name="ruleField">
                  <option value="title" <%= !filterDraft || filterDraft.sourceFilterId ? "selected" : (filterDraft.ruleField === "title" ? "selected" : "") %>>Title</option>
                  <option value="content" <%= filterDraft && !filterDraft.sourceFilterId && filterDraft.ruleField === "content" ? "selected" : "" %>>Content</option>
                  <option value="author" <%= filterDraft && !filterDraft.sourceFilterId && filterDraft.ruleField === "author" ? "selected" : "" %>>Author</option>
                  <option value="link" <%= filterDraft && !filterDraft.sourceFilterId && filterDraft.ruleField === "link" ? "selected" : "" %>>Link</option>
                  <option value="tags" <%= filterDraft && !filterDraft.sourceFilterId && filterDraft.ruleField === "tags" ? "selected" : "" %>>Tags</option>
                </select>
              </div>
            </div>
            <div class="field">
              <input class="input" type="text" name="rulePattern" placeholder="Regex pattern" value="<%= filterDraft?.sourceFilterId ? '' : (filterDraft?.rulePattern || '') %>" required />
            </div>
            <div class="field">
              <div class="select is-fullwidth">
                <select name="actionType" data-action-type-select>
                  <option value="markRead" <%= !filterDraft || filterDraft.sourceFilterId ? "selected" : (filterDraft.actionType === "markRead" ? "selected" : "") %>>Mark Read</option>
                  <option value="star" <%= filterDraft && !filterDraft.sourceFilterId && filterDraft.actionType === "star" ? "selected" : "" %>>Star</option>
                  <option value="publish" <%= filterDraft && !filterDraft.sourceFilterId && filterDraft.actionType === "publish" ? "selected" : "" %>>Publish</option>
                  <option value="label" <%= filterDraft && !filterDraft.sourceFilterId && filterDraft.actionType === "label" ? "selected" : "" %>>Apply Label</option>
                  <option value="tag" <%= filterDraft && !filterDraft.sourceFilterId && filterDraft.actionType === "tag" ? "selected" : "" %>>Assign Tag</option>
                  <option value="score" <%= filterDraft && !filterDraft.sourceFilterId && filterDraft.actionType === "score" ? "selected" : "" %>>Adjust Score</option>
                  <option value="delete" <%= filterDraft && !filterDraft.sourceFilterId && filterDraft.actionType === "delete" ? "selected" : "" %>>Delete</option>
                </select>
              </div>
            </div>
            <div class="field" data-action-value-field>
              <label class="label">Action value</label>
              <input class="input" type="text" name="actionValue" placeholder="Action value" value="<%= filterDraft?.sourceFilterId ? '' : (filterDraft?.actionValue || '') %>" />
            </div>
            <div class="field" data-label-action-field hidden>
              <label class="label">Label</label>
              <div class="select is-fullwidth">
                <select name="labelActionValue">
                  <option value="">Choose a label for label actions</option>
                  <% labels.forEach((label) => { %>
                    <option value="<%= label._id %>" <%= filterDraft && !filterDraft.sourceFilterId && String(filterDraft.labelActionValue || '') === String(label._id) ? "selected" : "" %>><%= label.name %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <input type="hidden" name="matchMode" value="all" />
            <div class="buttons">
              <button class="button is-warning">Create Filter</button>
              <button class="button is-light" type="submit" formaction="/prefs/filters/preview">Preview</button>
            </div>
          </form>
          <hr />
          <% filters.forEach((filter) => { %>
            <details class="box mb-4 disclosure-panel" <%= filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? "open" : "" %>>
              <summary class="disclosure-summary">
                <div>
                  <p class="has-text-weight-semibold">
                    <%= filter.caption %>
                    <span class="tag ml-2 <%= filter.enabled === false ? 'is-light' : 'is-success is-light' %>">
                      <%= filter.enabled === false ? 'Disabled' : 'Enabled' %>
                    </span>
                  </p>
                  <p class="is-size-7"><%= filter.rules[0]?.field %> matches <code><%= filter.rules[0]?.pattern %></code> and <strong><%= filter.actions[0]?.type %></strong></p>
                </div>
                <span class="button is-small is-light disclosure-button">Edit</span>
              </summary>
              <div class="disclosure-body">
                <form action="/prefs/filters/<%= filter._id %>" method="post" data-filter-form>
                  <input type="hidden" name="sourceFilterId" value="<%= filter._id %>" />
                  <div class="field">
                    <label class="label">Caption</label>
                    <input class="input" type="text" name="caption" value="<%= filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? filterDraft.caption : filter.caption %>" required />
                  </div>
                  <div class="field">
                    <label class="checkbox">
                      <input type="hidden" name="enabled" value="off" />
                      <input type="checkbox" name="enabled" value="on" <%= filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? (filterDraft.enabled ? "checked" : "") : (filter.enabled === false ? "" : "checked") %> />
                      <span class="ml-2">Enabled</span>
                    </label>
                  </div>
                  <div class="field">
                    <label class="label">Match field</label>
                    <div class="select is-fullwidth">
                      <select name="ruleField">
                        <option value="title" <%= (filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? filterDraft.ruleField : filter.rules[0]?.field) === "title" ? "selected" : "" %>>Title</option>
                        <option value="content" <%= (filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? filterDraft.ruleField : filter.rules[0]?.field) === "content" ? "selected" : "" %>>Content</option>
                        <option value="author" <%= (filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? filterDraft.ruleField : filter.rules[0]?.field) === "author" ? "selected" : "" %>>Author</option>
                        <option value="link" <%= (filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? filterDraft.ruleField : filter.rules[0]?.field) === "link" ? "selected" : "" %>>Link</option>
                        <option value="tags" <%= (filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? filterDraft.ruleField : filter.rules[0]?.field) === "tags" ? "selected" : "" %>>Tags</option>
                      </select>
                    </div>
                  </div>
                  <div class="field">
                    <label class="label">Regex pattern</label>
                    <input class="input" type="text" name="rulePattern" value="<%= filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? filterDraft.rulePattern : filter.rules[0]?.pattern %>" required />
                  </div>
                  <div class="field">
                    <label class="label">Action</label>
                    <div class="select is-fullwidth">
                      <select name="actionType" data-action-type-select>
                        <% const currentActionType = filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? filterDraft.actionType : filter.actions[0]?.type; %>
                        <option value="markRead" <%= currentActionType === "markRead" ? "selected" : "" %>>Mark Read</option>
                        <option value="star" <%= currentActionType === "star" ? "selected" : "" %>>Star</option>
                        <option value="publish" <%= currentActionType === "publish" ? "selected" : "" %>>Publish</option>
                        <option value="label" <%= currentActionType === "label" ? "selected" : "" %>>Apply Label</option>
                        <option value="tag" <%= currentActionType === "tag" ? "selected" : "" %>>Assign Tag</option>
                        <option value="score" <%= currentActionType === "score" ? "selected" : "" %>>Adjust Score</option>
                        <option value="delete" <%= currentActionType === "delete" ? "selected" : "" %>>Delete</option>
                      </select>
                    </div>
                  </div>
                  <div class="field" data-action-value-field>
                    <label class="label">Action value</label>
                    <input class="input" type="text" name="actionValue" value="<%= filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? filterDraft.actionValue : (filter.actions[0]?.type === 'label' ? '' : (filter.actions[0]?.value || '')) %>" placeholder="Action value" />
                  </div>
                  <div class="field" data-label-action-field hidden>
                    <label class="label">Label</label>
                    <div class="select is-fullwidth">
                      <select name="labelActionValue">
                        <option value="">Choose a label for label actions</option>
                        <% labels.forEach((label) => { %>
                          <option value="<%= label._id %>" <%= String(filterDraft?.sourceFilterId && String(filterDraft.sourceFilterId) === String(filter._id) ? (filterDraft.labelActionValue || '') : (filter.actions[0]?.value || '')) === String(label._id) ? "selected" : "" %>><%= label.name %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                  <input type="hidden" name="matchMode" value="<%= filter.matchMode || 'all' %>" />
                  <div class="buttons">
                    <button class="button is-primary">Save Filter</button>
                    <button class="button is-light" type="submit" formaction="/prefs/filters/preview">Preview</button>
                  </div>
                </form>
                <div class="buttons mt-3">
                  <form action="/prefs/filters/<%= filter._id %>/toggle" method="post">
                    <button class="button is-light"><%= filter.enabled === false ? 'Enable' : 'Disable' %></button>
                  </form>
                  <form action="/prefs/filters/<%= filter._id %>/delete" method="post" onsubmit="return confirm('Delete this filter?');">
                    <button class="button is-danger is-light">Delete</button>
                  </form>
                </div>
              </div>
            </details>
          <% }) %>
        </div>
      </div>

      <div class="column">
        <div class="box glass-panel">
          <h2 class="title is-5">AI Sources</h2>
          <p class="is-size-7 mb-4">Turn a page without an official feed into a verified, repairable source.</p>
          <% if (aiSourceError) { %>
            <div class="notification is-danger is-light mb-4"><%= aiSourceError %></div>
          <% } %>
          <% if (!hasOpenAIConfig) { %>
            <div class="notification is-light mb-4">
              Add `OPENAI_API_KEY` to your environment to enable AI source setup.
            </div>
          <% } %>
          <form action="/prefs/ai-sources/preview" method="post">
            <div class="field">
              <label class="label">Feed title</label>
              <input class="input" type="text" name="title" value="<%= aiSourceDraft?.feedId ? '' : (aiSourceDraft?.title || '') %>" placeholder="Optional title override" />
            </div>
            <div class="field">
              <label class="label">Source URL</label>
              <input class="input" type="url" name="sourceUrl" value="<%= aiSourceDraft?.sourceUrl || '' %>" placeholder="https://example.com/latest" required />
            </div>
            <div class="field">
              <label class="label">Guidance</label>
              <textarea class="textarea" name="guidance" rows="3" placeholder="Tell the AI what to include or ignore."><%= aiSourceDraft?.guidance || '' %></textarea>
            </div>
            <div class="field">
              <label class="label">Fetch mode</label>
              <div class="select is-fullwidth">
                <select name="fetchMode">
                  <option value="auto" <%= (aiSourceDraft?.fetchMode || 'auto') === "auto" ? "selected" : "" %>>Auto</option>
                  <option value="direct" <%= aiSourceDraft?.fetchMode === "direct" ? "selected" : "" %>>Direct fetch only</option>
                  <option value="browser" <%= aiSourceDraft?.fetchMode === "browser" ? "selected" : "" %>>Browser-rendered</option>
                </select>
              </div>
              <p class="help">Use browser-rendered mode for JS-heavy or bot-protected pages.</p>
            </div>
            <div class="field">
              <label class="label">Browser wait strategy</label>
              <div class="select is-fullwidth">
                <select name="waitUntil">
                  <option value="networkidle" <%= (aiSourceDraft?.waitUntil || 'networkidle') === "networkidle" ? "selected" : "" %>>Network idle</option>
                  <option value="load" <%= aiSourceDraft?.waitUntil === "load" ? "selected" : "" %>>Page load</option>
                  <option value="domcontentloaded" <%= aiSourceDraft?.waitUntil === "domcontentloaded" ? "selected" : "" %>>DOM content loaded</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label class="label">Wait for selector</label>
              <input class="input" type="text" name="waitForSelector" value="<%= aiSourceDraft?.waitForSelector || '' %>" placeholder=".stream-item, article, [data-content-type='article']" />
            </div>
            <div class="field">
              <label class="label">Extra wait after load (ms)</label>
              <input class="input" type="number" name="waitAfterLoadMs" min="0" step="100" value="<%= aiSourceDraft?.waitAfterLoadMs || 1500 %>" />
            </div>
            <div class="field">
              <label class="label">Folders</label>
              <div class="fixed-checkbox-list">
                <% if (categories.length === 0) { %>
                  <p class="is-size-7">No folders yet. This source can still be created without one.</p>
                <% } %>
                <% categories.forEach((category) => { %>
                  <label class="checkbox is-block mb-2">
                    <input type="checkbox" name="categoryIds" value="<%= category._id %>" <%= aiSourceDraft?.categoryIds?.includes(String(category._id)) ? "checked" : "" %> />
                    <span class="ml-2"><%= category.name %></span>
                  </label>
                <% }) %>
              </div>
            </div>
            <% if (aiSourceDraft?.feedId) { %>
              <input type="hidden" name="feedId" value="<%= aiSourceDraft.feedId %>" />
            <% } %>
            <div class="buttons">
              <button class="button is-primary">Generate Preview</button>
              <% if (aiSourceDraft?.sourceUrl) { %>
                <a class="button is-light" href="/prefs/ai-sources/debug-source" target="_blank" rel="noreferrer">Open Fetched Source</a>
              <% } %>
            </div>
          </form>

          <% if (aiSourceDraft?.candidate) { %>
            <hr />
            <h3 class="title is-6">Verify Extracted Items</h3>
            <p class="is-size-7 mb-3">Confirm these are the items you want before the source is saved.</p>
            <div class="notification is-light mb-4">
              <p class="has-text-weight-semibold"><%= aiSourceDraft.candidate.feedTitle %></p>
              <p class="is-size-7"><%= aiSourceDraft.candidate.notes %></p>
              <p class="is-size-7 mt-2">Resolved fetch mode: <strong><%= aiSourceDraft.candidate.resolvedFetchMode || aiSourceDraft.fetchMode || 'auto' %></strong></p>
            </div>
            <% aiSourceDraft.candidate.previewItems.forEach((item) => { %>
              <article class="box mb-3">
                <p class="has-text-weight-semibold"><a href="<%= item.link %>" target="_blank" rel="noreferrer"><%= item.title %></a></p>
                <% if (item.publishedAt) { %><p class="is-size-7"><%= item.publishedAt %></p><% } %>
                <% if (item.summary) { %><p class="is-size-7 mt-2"><%= item.summary %></p><% } %>
              </article>
            <% }) %>
            <div class="buttons">
              <form action="/prefs/ai-sources/confirm" method="post">
                <button class="button is-success">Confirm Source</button>
              </form>
              <form action="/prefs/ai-sources/discard" method="post">
                <button class="button is-light">Discard</button>
              </form>
            </div>
            <p class="is-size-7 mt-2">Need a different set of items? Adjust the guidance above and generate another preview.</p>
          <% } %>

          <% if (aiSourceDraft?.debug) { %>
            <hr />
            <h3 class="title is-6">Rendered Page Debug</h3>
            <p class="is-size-7 mb-3">Use this to refine guidance, switch fetch mode, or add a selector to wait for before the preview runs.</p>
            <div class="box is-shadowless has-background-light debug-panel">
              <div class="content is-small">
                <p><strong>Page title:</strong> <%= aiSourceDraft.debug.pageTitle %></p>
                <p><strong>Requested mode:</strong> <%= aiSourceDraft.debug.requestedFetchMode %> | <strong>Resolved mode:</strong> <%= aiSourceDraft.debug.resolvedFetchMode %></p>
                <% if (aiSourceDraft.debug.generationModel) { %>
                  <p><strong>Rule model:</strong> <%= aiSourceDraft.debug.generationModel %><% if (aiSourceDraft.debug.generationFallbackUsed) { %> (fallback used)<% } %></p>
                <% } %>
                <% if (aiSourceDraft.debug.generationAttemptedModels?.length) { %>
                  <p><strong>Attempted models:</strong> <%= aiSourceDraft.debug.generationAttemptedModels.join(", ") %></p>
                <% } %>
                <p><strong>Final URL:</strong> <a href="<%= aiSourceDraft.debug.finalUrl %>" target="_blank" rel="noreferrer"><%= aiSourceDraft.debug.finalUrl %></a></p>
                <p><strong>Wait strategy:</strong> <%= aiSourceDraft.debug.waitUntil %><% if (aiSourceDraft.debug.waitForSelector) { %> | <strong>Wait selector:</strong> <code><%= aiSourceDraft.debug.waitForSelector %></code><% } %> | <strong>Extra wait:</strong> <%= aiSourceDraft.debug.waitAfterLoadMs %>ms</p>
                <p><strong>Element counts:</strong> <%= aiSourceDraft.debug.selectorCounts.article %> article tags, <%= aiSourceDraft.debug.selectorCounts.links %> links, <%= aiSourceDraft.debug.selectorCounts.headings %> headings</p>
              </div>

              <% if (aiSourceDraft.debug.candidateRule) { %>
                <div class="content is-small mt-4">
                  <p class="has-text-weight-semibold">Candidate rule</p>
                  <pre><%= JSON.stringify(aiSourceDraft.debug.candidateRule, null, 2) %></pre>
                  <p class="mt-3"><strong>Rule match counts:</strong></p>
                  <pre><%= JSON.stringify(aiSourceDraft.debug.candidateMatchCounts, null, 2) %></pre>
                  <% if (aiSourceDraft.debug.firstItemPreview) { %>
                    <p class="mt-3"><strong>First matched item preview:</strong></p>
                    <pre><%= JSON.stringify(aiSourceDraft.debug.firstItemPreview, null, 2) %></pre>
                  <% } %>
                </div>
              <% } %>

              <% if (aiSourceDraft.debug.containerSamples?.length) { %>
                <div class="content is-small mt-4">
                  <p class="has-text-weight-semibold">Possible article containers</p>
                  <% aiSourceDraft.debug.containerSamples.forEach((sample) => { %>
                    <article class="box mb-3">
                      <p class="is-size-7 mb-1"><code><%= sample.selector %></code></p>
                      <% if (sample.href) { %>
                        <p class="mb-1"><a href="<%= sample.href %>" target="_blank" rel="noreferrer"><%= sample.href %></a></p>
                      <% } %>
                      <p class="is-size-7"><%= sample.text %></p>
                    </article>
                  <% }) %>
                </div>
              <% } %>

              <% if (aiSourceDraft.debug.topLinks?.length) { %>
                <div class="content is-small mt-4">
                  <p class="has-text-weight-semibold">Sample links found on the page</p>
                  <% aiSourceDraft.debug.topLinks.forEach((link) => { %>
                    <p class="mb-2">
                      <a href="<%= link.href %>" target="_blank" rel="noreferrer"><%= link.text %></a>
                    </p>
                  <% }) %>
                </div>
              <% } %>

              <% if (aiSourceDraft.debug.bodyTextSnippet) { %>
                <div class="content is-small mt-4">
                  <p class="has-text-weight-semibold">Rendered text snippet</p>
                  <pre><%= aiSourceDraft.debug.bodyTextSnippet %></pre>
                </div>
              <% } %>
            </div>
          <% } %>

          <% if (aiSources.length > 0) { %>
            <hr />
            <h3 class="title is-6">Existing AI Sources</h3>
            <% aiSources.forEach((source) => { %>
              <details class="box mb-3 disclosure-panel">
                <summary class="disclosure-summary">
                  <div>
                    <p class="has-text-weight-semibold"><%= source.title %></p>
                    <p class="is-size-7"><%= source.feedUrl %></p>
                  </div>
                  <span class="tag <%= source.aiConfig?.verificationStatus === 'failed' ? 'is-danger is-light' : 'is-success is-light' %>">
                    <%= source.aiConfig?.verificationStatus || 'verified' %>
                  </span>
                </summary>
                <div class="disclosure-body">
                  <p class="is-size-7 mb-3">Guidance: <%= source.aiConfig?.guidance || "None" %></p>
                  <p class="is-size-7 mb-3">Fetch mode: <strong><%= source.aiConfig?.fetchMode || "auto" %></strong><% if (source.aiConfig?.lastResolvedFetchMode) { %> (last used: <%= source.aiConfig.lastResolvedFetchMode %>)<% } %></p>
                  <% if (source.aiConfig?.lastRepairReason) { %>
                    <p class="is-size-7 mb-3">Last repair: <%= source.aiConfig.lastRepairReason %></p>
                  <% } %>
                  <form action="/feeds/<%= source._id %>/ai-repair" method="post">
                    <div class="field">
                      <label class="label">Repair guidance</label>
                      <textarea class="textarea" name="guidance" rows="2"><%= source.aiConfig?.guidance || "" %></textarea>
                    </div>
                    <div class="field">
                      <label class="label">Fetch mode</label>
                      <div class="select is-fullwidth">
                        <select name="fetchMode">
                          <option value="auto" <%= (source.aiConfig?.fetchMode || 'auto') === "auto" ? "selected" : "" %>>Auto</option>
                          <option value="direct" <%= source.aiConfig?.fetchMode === "direct" ? "selected" : "" %>>Direct fetch only</option>
                          <option value="browser" <%= source.aiConfig?.fetchMode === "browser" ? "selected" : "" %>>Browser-rendered</option>
                        </select>
                      </div>
                    </div>
                    <div class="field">
                      <label class="label">Wait strategy</label>
                      <div class="select is-fullwidth">
                        <select name="waitUntil">
                          <option value="networkidle" <%= (source.aiConfig?.waitUntil || 'networkidle') === "networkidle" ? "selected" : "" %>>Network idle</option>
                          <option value="load" <%= source.aiConfig?.waitUntil === "load" ? "selected" : "" %>>Page load</option>
                          <option value="domcontentloaded" <%= source.aiConfig?.waitUntil === "domcontentloaded" ? "selected" : "" %>>DOM content loaded</option>
                        </select>
                      </div>
                    </div>
                    <div class="field">
                      <label class="label">Wait for selector</label>
                      <input class="input" type="text" name="waitForSelector" value="<%= source.aiConfig?.waitForSelector || '' %>" />
                    </div>
                    <div class="field">
                      <label class="label">Extra wait after load (ms)</label>
                      <input class="input" type="number" name="waitAfterLoadMs" min="0" step="100" value="<%= source.aiConfig?.waitAfterLoadMs || 1500 %>" />
                    </div>
                    <button class="button is-light">Generate Repair Preview</button>
                  </form>
                </div>
              </details>
            <% }) %>
          <% } %>
        </div>

        <div class="box glass-panel">
          <h2 class="title is-5">Newsletter Sources</h2>
          <p class="is-size-7 mb-4">Create a feed from newsletter emails delivered to your dedicated mailbox.</p>
          <% if (newsletterSourceError) { %>
            <div class="notification is-danger is-light mb-4"><%= newsletterSourceError %></div>
          <% } %>
          <% if (!hasImapConfig) { %>
            <div class="notification is-light mb-4">
              Add `IMAP_HOST`, `IMAP_USER`, and `IMAP_PASSWORD` to your environment to enable newsletter sources.
            </div>
          <% } %>
          <% if (!hasOpenAIConfig) { %>
            <div class="notification is-light mb-4">
              Add `OPENAI_API_KEY` to your environment to enable newsletter extraction.
            </div>
          <% } %>
          <form action="/prefs/newsletter-sources/preview" method="post">
            <div class="field">
              <label class="label">Feed title</label>
              <input class="input" type="text" name="title" value="<%= newsletterSourceDraft?.feedId ? '' : (newsletterSourceDraft?.title || '') %>" placeholder="Optional title override" />
            </div>
            <div class="field">
              <label class="label">Sender pattern</label>
              <input class="input" type="text" name="senderPattern" value="<%= newsletterSourceDraft?.senderPattern || '' %>" placeholder="newsletter@publisher.com or Fast Company" />
            </div>
            <div class="field">
              <label class="label">Subject pattern</label>
              <input class="input" type="text" name="subjectPattern" value="<%= newsletterSourceDraft?.subjectPattern || '' %>" placeholder="Daily Briefing, Morning Report, etc." />
              <p class="help">Use either sender, subject, or both. Patterns are matched case-insensitively.</p>
            </div>
            <div class="field">
              <label class="label">Forwarding account pattern</label>
              <input class="input" type="text" name="forwardedByPattern" value="<%= newsletterSourceDraft?.forwardedByPattern || '' %>" placeholder="Optional forwarding mailbox or alias" />
              <p class="help">Optional. Match the account that forwarded the newsletter while still extracting the original publisher from the forwarded content.</p>
            </div>
            <div class="field">
              <label class="label">Mailbox</label>
              <input class="input" type="text" name="mailbox" value="<%= newsletterSourceDraft?.mailbox || 'INBOX' %>" placeholder="INBOX" />
            </div>
            <div class="field">
              <label class="label">Guidance</label>
              <textarea class="textarea" name="guidance" rows="3" placeholder="Tell the AI which blocks are real stories and what to ignore."><%= newsletterSourceDraft?.guidance || '' %></textarea>
            </div>
            <div class="field">
              <label class="label">Folders</label>
              <div class="fixed-checkbox-list">
                <% if (categories.length === 0) { %>
                  <p class="is-size-7">No folders yet. This source can still be created without one.</p>
                <% } %>
                <% categories.forEach((category) => { %>
                  <label class="checkbox is-block mb-2">
                    <input type="checkbox" name="categoryIds" value="<%= category._id %>" <%= newsletterSourceDraft?.categoryIds?.includes(String(category._id)) ? "checked" : "" %> />
                    <span class="ml-2"><%= category.name %></span>
                  </label>
                <% }) %>
              </div>
            </div>
            <% if (newsletterSourceDraft?.feedId) { %>
              <input type="hidden" name="feedId" value="<%= newsletterSourceDraft.feedId %>" />
            <% } %>
            <button class="button is-primary">Preview Newsletter</button>
          </form>

          <% if (newsletterSourceDraft?.candidate) { %>
            <hr />
            <h3 class="title is-6">Verify Extracted Newsletter Items</h3>
            <% if (newsletterSourceDraft.message) { %>
              <div class="notification is-light mb-4">
                <p class="has-text-weight-semibold"><%= newsletterSourceDraft.message.subject %></p>
                <p class="is-size-7">From <%= newsletterSourceDraft.message.from %></p>
                <% if (newsletterSourceDraft.message.originalFrom || newsletterSourceDraft.message.originalSubject) { %>
                  <p class="is-size-7">Original newsletter: <%= newsletterSourceDraft.message.originalFrom || "Unknown sender" %><% if (newsletterSourceDraft.message.originalSubject) { %> | <%= newsletterSourceDraft.message.originalSubject %><% } %></p>
                <% } %>
                <% if (newsletterSourceDraft.message.receivedAt) { %>
                  <p class="is-size-7">Received <%= new Date(newsletterSourceDraft.message.receivedAt).toLocaleString() %></p>
                <% } %>
                <% if (newsletterSourceDraft.candidate.generationModel) { %>
                  <p class="is-size-7 mt-2">Rule model: <strong><%= newsletterSourceDraft.candidate.generationModel %></strong><% if (newsletterSourceDraft.candidate.generationFallbackUsed) { %> (fallback used)<% } %></p>
                <% } %>
              </div>
            <% } %>
            <% newsletterSourceDraft.candidate.previewItems.forEach((item) => { %>
              <article class="box mb-3">
                <p class="has-text-weight-semibold"><a href="<%= item.link %>" target="_blank" rel="noreferrer"><%= item.title %></a></p>
                <% if (item.publishedAt) { %><p class="is-size-7"><%= item.publishedAt %></p><% } %>
                <% if (item.summary) { %><p class="is-size-7 mt-2"><%= item.summary %></p><% } %>
              </article>
            <% }) %>
            <div class="buttons">
              <form action="/prefs/newsletter-sources/confirm" method="post">
                <button class="button is-success">Confirm Newsletter Source</button>
              </form>
              <form action="/prefs/newsletter-sources/discard" method="post">
                <button class="button is-light">Discard</button>
              </form>
            </div>
            <p class="is-size-7 mt-2">Need a different result? Adjust the sender, subject, or guidance above and preview again.</p>
          <% } %>

          <% if (newsletterSources.length > 0) { %>
            <hr />
            <h3 class="title is-6">Existing Newsletter Sources</h3>
            <% newsletterSources.forEach((source) => { %>
              <details class="box mb-3 disclosure-panel">
                <summary class="disclosure-summary">
                  <div>
                    <p class="has-text-weight-semibold"><%= source.title %></p>
                    <p class="is-size-7"><%= source.newsletterConfig?.senderPattern || "Any sender" %> | <%= source.newsletterConfig?.subjectPattern || "Any subject" %></p>
                  </div>
                  <span class="tag <%= source.newsletterConfig?.verificationStatus === 'failed' ? 'is-danger is-light' : 'is-success is-light' %>">
                    <%= source.newsletterConfig?.verificationStatus || 'verified' %>
                  </span>
                </summary>
                <div class="disclosure-body">
                  <p class="is-size-7 mb-3">Mailbox: <strong><%= source.newsletterConfig?.mailbox || "INBOX" %></strong></p>
                  <% if (source.newsletterConfig?.forwardedByPattern) { %>
                    <p class="is-size-7 mb-3">Forwarded by: <strong><%= source.newsletterConfig.forwardedByPattern %></strong></p>
                  <% } %>
                  <p class="is-size-7 mb-3">Guidance: <%= source.newsletterConfig?.guidance || "None" %></p>
                  <% if (source.newsletterConfig?.latestMessageSubject) { %>
                    <p class="is-size-7 mb-3">Last matched message: <%= source.newsletterConfig.latestMessageSubject %></p>
                  <% } %>
                  <form action="/prefs/newsletter-sources/preview" method="post">
                    <input type="hidden" name="feedId" value="<%= source._id %>" />
                    <input type="hidden" name="title" value="<%= source.title %>" />
                    <input type="hidden" name="senderPattern" value="<%= source.newsletterConfig?.senderPattern || '' %>" />
                    <input type="hidden" name="subjectPattern" value="<%= source.newsletterConfig?.subjectPattern || '' %>" />
                    <input type="hidden" name="forwardedByPattern" value="<%= source.newsletterConfig?.forwardedByPattern || '' %>" />
                    <input type="hidden" name="mailbox" value="<%= source.newsletterConfig?.mailbox || 'INBOX' %>" />
                    <% getFeedCategoryIds(source).forEach((categoryId) => { %>
                      <input type="hidden" name="categoryIds" value="<%= categoryId %>" />
                    <% }) %>
                    <div class="field">
                      <label class="label">Repair guidance</label>
                      <textarea class="textarea" name="guidance" rows="2"><%= source.newsletterConfig?.guidance || "" %></textarea>
                    </div>
                    <button class="button is-light">Generate Repair Preview</button>
                  </form>
                </div>
              </details>
            <% }) %>
          <% } %>
        </div>

        <div class="box glass-panel">
          <h2 class="title is-5">Bluesky Sources</h2>
          <p class="is-size-7 mb-4">Create a feed from a Bluesky profile using the public Bluesky AppView.</p>
          <% if (blueskySourceError) { %>
            <div class="notification is-danger is-light mb-4"><%= blueskySourceError %></div>
          <% } %>
          <form action="/prefs/bluesky-sources/preview" method="post">
            <div class="field">
              <label class="label">Feed title</label>
              <input class="input" type="text" name="title" value="<%= blueskySourceDraft?.feedId ? '' : (blueskySourceDraft?.title || '') %>" placeholder="Optional title override" />
            </div>
            <div class="field">
              <label class="label">Bluesky handle</label>
              <input class="input" type="text" name="handle" value="<%= blueskySourceDraft?.handle || '' %>" placeholder="example.bsky.social" required />
              <p class="help">Enter the handle without the profile URL. `@` is optional.</p>
            </div>
            <div class="field is-grouped is-grouped-multiline">
              <label class="checkbox mr-4">
                <input type="checkbox" name="includeReplies" <%= blueskySourceDraft?.includeReplies ? "checked" : "" %> />
                <span class="ml-2">Include replies</span>
              </label>
              <label class="checkbox">
                <input type="checkbox" name="includeReposts" <%= blueskySourceDraft?.includeReposts ? "checked" : "" %> />
                <span class="ml-2">Include reposts</span>
              </label>
            </div>
            <div class="field">
              <label class="label">Folders</label>
              <div class="fixed-checkbox-list">
                <% if (categories.length === 0) { %>
                  <p class="is-size-7">No folders yet. This source can still be created without one.</p>
                <% } %>
                <% categories.forEach((category) => { %>
                  <label class="checkbox is-block mb-2">
                    <input type="checkbox" name="categoryIds" value="<%= category._id %>" <%= blueskySourceDraft?.categoryIds?.includes(String(category._id)) ? "checked" : "" %> />
                    <span class="ml-2"><%= category.name %></span>
                  </label>
                <% }) %>
              </div>
            </div>
            <% if (blueskySourceDraft?.feedId) { %>
              <input type="hidden" name="feedId" value="<%= blueskySourceDraft.feedId %>" />
            <% } %>
            <button class="button is-primary">Preview Bluesky Source</button>
          </form>

          <% if (blueskySourceDraft?.candidate) { %>
            <hr />
            <h3 class="title is-6">Verify Bluesky Posts</h3>
            <div class="notification is-light mb-4">
              <p class="has-text-weight-semibold"><%= blueskySourceDraft.candidate.feedTitle %></p>
              <p class="is-size-7"><a href="<%= blueskySourceDraft.candidate.siteUrl %>" target="_blank" rel="noreferrer"><%= blueskySourceDraft.candidate.siteUrl %></a></p>
              <p class="is-size-7 mt-2"><%= blueskySourceDraft.candidate.notes %></p>
            </div>
            <% blueskySourceDraft.candidate.previewItems.forEach((item) => { %>
              <article class="box mb-3">
                <p class="has-text-weight-semibold"><a href="<%= item.link %>" target="_blank" rel="noreferrer"><%= item.title %></a></p>
                <% if (item.publishedAt) { %><p class="is-size-7"><%= item.publishedAt %></p><% } %>
                <% if (item.summary) { %><p class="is-size-7 mt-2"><%= item.summary %></p><% } %>
              </article>
            <% }) %>
            <div class="buttons">
              <form action="/prefs/bluesky-sources/confirm" method="post">
                <button class="button is-success">Confirm Bluesky Source</button>
              </form>
              <form action="/prefs/bluesky-sources/discard" method="post">
                <button class="button is-light">Discard</button>
              </form>
            </div>
          <% } %>

          <% if (blueskySources.length > 0) { %>
            <hr />
            <h3 class="title is-6">Existing Bluesky Sources</h3>
            <% blueskySources.forEach((source) => { %>
              <details class="box mb-3 disclosure-panel">
                <summary class="disclosure-summary">
                  <div>
                    <p class="has-text-weight-semibold"><%= source.title %></p>
                    <p class="is-size-7">@<%= source.blueskyConfig?.handle || source.feedUrl %></p>
                  </div>
                  <span class="tag <%= source.blueskyConfig?.verificationStatus === 'failed' ? 'is-danger is-light' : 'is-success is-light' %>">
                    <%= source.blueskyConfig?.verificationStatus || 'verified' %>
                  </span>
                </summary>
                <div class="disclosure-body">
                  <p class="is-size-7 mb-3">Replies: <strong><%= source.blueskyConfig?.includeReplies ? "included" : "excluded" %></strong> | Reposts: <strong><%= source.blueskyConfig?.includeReposts ? "included" : "excluded" %></strong></p>
                  <form action="/prefs/bluesky-sources/preview" method="post">
                    <input type="hidden" name="feedId" value="<%= source._id %>" />
                    <input type="hidden" name="title" value="<%= source.title %>" />
                    <input type="hidden" name="handle" value="<%= source.blueskyConfig?.handle || '' %>" />
                    <% if (source.blueskyConfig?.includeReplies) { %><input type="hidden" name="includeReplies" value="on" /><% } %>
                    <% if (source.blueskyConfig?.includeReposts) { %><input type="hidden" name="includeReposts" value="on" /><% } %>
                    <% getFeedCategoryIds(source).forEach((categoryId) => { %>
                      <input type="hidden" name="categoryIds" value="<%= categoryId %>" />
                    <% }) %>
                    <button class="button is-light">Generate Repair Preview</button>
                  </form>
                </div>
              </details>
            <% }) %>
          <% } %>
        </div>

        <div class="box glass-panel">
          <h2 class="title is-5">Generated Feeds</h2>
          <form action="/prefs/generated-feeds" method="post">
            <div class="field">
              <div class="select is-fullwidth">
                <select name="scope">
                  <option value="special">Special</option>
                  <option value="feed">Feed</option>
                  <option value="label">Label</option>
                </select>
              </div>
            </div>
            <div class="field">
              <input class="input" type="text" name="targetId" placeholder="Target ID or starred" required />
            </div>
            <div class="field">
              <div class="select is-fullwidth">
                <select name="format">
                  <option value="atom">Atom</option>
                  <option value="json">JSON Feed</option>
                </select>
              </div>
            </div>
            <button class="button is-success">Create Generated Feed</button>
          </form>
          <hr />
          <% generatedFeeds.forEach((item) => { %>
            <p><a href="/public/feeds/<%= item.key %>"><%= item.title %></a></p>
          <% }) %>
        </div>

        <div class="box glass-panel">
          <h2 class="title is-5">Plugins</h2>
          <% plugins.forEach((plugin) => { %>
            <div class="media mb-3">
              <div class="media-content">
                <p class="has-text-weight-semibold"><%= plugin.name %></p>
                <p class="is-size-7"><%= plugin.description %></p>
              </div>
              <div class="media-right">
                <span class="tag <%= plugin.enabled ? 'is-success' : 'is-light' %>"><%= plugin.scope %></span>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  (() => {
    const forms = document.querySelectorAll("[data-filter-form]");
    forms.forEach((form) => {
      const actionSelect = form.querySelector("[data-action-type-select]");
      const actionValueField = form.querySelector("[data-action-value-field]");
      const actionValueInput = actionValueField?.querySelector("input[name='actionValue']");
      const labelField = form.querySelector("[data-label-action-field]");
      const labelSelect = labelField?.querySelector("select[name='labelActionValue']");

      if (!actionSelect) return;

      const updateVisibility = () => {
        const value = actionSelect.value;
        const needsActionValue = value === "tag" || value === "score";
        const needsLabel = value === "label";

        if (actionValueField) actionValueField.hidden = !needsActionValue;
        if (labelField) labelField.hidden = !needsLabel;

        if (actionValueInput) {
          actionValueInput.disabled = !needsActionValue;
          if (!needsActionValue && !form.action.includes("/prefs/filters/")) actionValueInput.value = "";
        }

        if (labelSelect) {
          labelSelect.disabled = !needsLabel;
          if (!needsLabel && !form.action.includes("/prefs/filters/")) labelSelect.value = "";
        }
      };

      actionSelect.addEventListener("change", updateVisibility);
      updateVisibility();
    });
  })();
</script>
<%- include("../partials/footer") %>
